# Copy to .env - never commit real secrets
NODE_ENV=development
DATABASE_URL=postgresql://triphub:triphub@localhost:5442/triphub
REDIS_URL=redis://localhost:6390
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-min-32-chars-long-random-value
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=triphub
S3_SECRET_KEY=triphub-secret
S3_BUCKET_PUBLIC=triphub-public
S3_BUCKET_PRIVATE=triphub-private
SMTP_URL=smtp://localhost:1025
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
FEATURE_CUSTODY_PAYMENTS=false
MFA_ENCRYPTION_KEY=change-me-another-32-char-random-secret

# Local development only (never production): show "sent" mails at /en/dev-mailbox
DEV_MAILBOX=0

# Real email (any SMTP server). DEV_MAILBOX=1 takes precedence locally; set it to 0 to send real mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TripHub

# Local testing only (refused in production): sign up with email + password and be signed in at once, no email check.
SIMPLE_SIGNUP=1
