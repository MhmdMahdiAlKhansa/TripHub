{
  "name": "@triphub/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.8",
    "@node-rs/argon2": "2.2.2",
    "@triphub/database": "workspace:*",
    "@triphub/shared": "workspace:*",
    "dotenv": "17.2.0",
    "ioredis": "^6.0.0",
    "jose": "6.0.12",
    "nodemailer": "7.0.5",
    "otpauth": "^9.6.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.0.0",
    "@types/nodemailer": "6.4.17",
    "@types/smtp-server": "3.5.10",
    "@types/supertest": "7.2.1",
    "mailparser": "3.7.4",
    "smtp-server": "3.14.0",
    "supertest": "7.3.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.12"
  }
